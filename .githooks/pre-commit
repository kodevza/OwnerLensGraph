#!/usr/bin/env sh
# Scans staged changes for secrets, then runs the project's test suite.

set -eu

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required but was not found on PATH." >&2
  echo "Install it from https://github.com/gitleaks/gitleaks, then retry." >&2
  exit 1
fi

echo "pre-commit: scanning staged changes for secrets..."
gitleaks protect --staged --redact

echo "pre-commit: running tests..."
npm test
